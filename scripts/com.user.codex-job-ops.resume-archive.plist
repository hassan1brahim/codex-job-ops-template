<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__.resume-archive</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__REPO_PATH__/scripts/resume_archive.py</string>
        <string>--older-than-hours</string>
        <string>24</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/codex-job-ops-resume-archive.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/codex-job-ops-resume-archive.err</string>
</dict>
</plist>
